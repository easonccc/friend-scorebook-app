/* pages/detail/detail.wxss */

/* 类型头卡 */
.type-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 28rpx;
}
.type-emoji { font-size: 56rpx; }
.type-name { font-size: 32rpx; font-weight: 700; flex: 1; }
.type-head .badge { font-size: 24rpx; padding: 8rpx 24rpx; }

/* 大比分 */
.score-big {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 28rpx;
}
.sb-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.sb-name { font-size: 28rpx; font-weight: 600; }
.sb-num { font-size: 108rpx; font-weight: 800; line-height: 1.1; }
.sb-colon { font-size: 60rpx; font-weight: 800; color: var(--ink2); }

/* 信息列表 */
.detail-info { padding: 8rpx 28rpx; }
.di-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.di-row:last-child { border-bottom: none; }
.di-label { font-size: 26rpx; color: var(--ink2); }
.di-value { font-size: 27rpx; color: var(--ink); font-weight: 500; }

/* 操作按钮 */
.edit-btn {
  margin-bottom: 20rpx;
  color: var(--green-d);
  border-color: var(--green);
  background: var(--green-s);
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-danger { height: 92rpx; line-height: 92rpx; font-size: 28rpx; }

/* 删除确认 */
.confirm-text {
  font-size: 24rpx;
  color: var(--ink2);
  text-align: center;
  margin-bottom: 28rpx;
  line-height: 1.7;
}
.sheet .btn-danger { margin-bottom: 20rpx; }
