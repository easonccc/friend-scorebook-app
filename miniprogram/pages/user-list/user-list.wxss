/* pages/user-list/user-list.wxss */
.count { font-size: 22rpx; color: var(--ink2); font-weight: 400; }

.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.user-row:last-child { border-bottom: none; }

.u-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--green-s);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.u-main { flex: 1; min-width: 0; }
.u-name {
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.tag {
  font-size: 18rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.tag-me { background: var(--green-s); color: var(--green-d); }
.tag-admin { background: #FFF3C4; color: #9A7B00; }
.u-sub {
  font-size: 22rpx;
  color: var(--ink2);
  margin-top: 6rpx;
}

.tip {
  font-size: 22rpx;
  color: var(--ink2);
  text-align: center;
  margin-top: 8rpx;
}
