/* pages/settings/settings.wxss */

.empty-sub { font-size: 24rpx; color: var(--ink2); margin-top: 8rpx; }

/* 人物 */
.name-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.name-label { width: 200rpx; font-size: 27rpx; }
.name-value {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.name-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
}
.name-save { margin-top: 28rpx; }
.name-tip {
  font-size: 22rpx;
  color: var(--ink2);
  text-align: center;
  margin-top: 16rpx;
}

/* 空间 */
.sp-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.sp-label { font-size: 27rpx; }
.sp-value { font-size: 27rpx; font-weight: 600; }
.sp-code-row { display: flex; align-items: center; gap: 16rpx; }
.sp-code {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: var(--green-d);
}
.sp-copy {
  padding: 8rpx 20rpx;
  background: var(--green-s);
  color: var(--green-d);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.sp-copy:active { transform: scale(0.95); }
.card .btn-ghost { margin-top: 38rpx; }

/* 默认比赛类型行 */
.def-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
}
.def-row:active { opacity: 0.7; }
.def-ava {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--green-s);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.def-main { flex: 1; min-width: 0; }
.def-name { font-size: 28rpx; font-weight: 700; }
.def-sub { font-size: 22rpx; color: var(--ink2); margin-top: 4rpx; }
.def-arrow { color: var(--line); font-size: 32rpx; }

/* 类型弹层（内置 + 我的自定义类型） */
.type-scroll { max-height: 560rpx; }

/* 我的空间列表 */
.space-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid var(--line);
}
.space-row:last-child { border-bottom: none; }
.space-row:active { opacity: 0.7; }
.space-row.on .sr-name { color: var(--green-d); }
.sr-ava {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}
.sr-ava.ava-me { background: var(--green-s); }
.sr-ava.ava-fr { background: var(--lose); }
.sr-mid { flex: 1; min-width: 0; }
.sr-name {
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.tag {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--green-d);
  background: var(--green-s);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.tag.tag-def {
  background: #FFF3C4;
  color: #9A7B00;
}
.sr-def {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--ink2);
  background: var(--lose);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}
.sr-def:active { transform: scale(0.92); background: var(--green-s); color: var(--green-d); }
.sr-sub {
  font-size: 22rpx;
  color: var(--ink2);
  margin-top: 6rpx;
}
.sr-check {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--green-d);
}

/* 关于 */
.about { text-align: center; padding: 36rpx; }
.about-line { font-size: 30rpx; font-weight: 700; }
.about-sub { font-size: 22rpx; color: var(--ink2); margin-top: 6rpx; }

/* 账号入口行 */
.acc-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.acc-row:last-child { border-bottom: none; }
.acc-row:active { background: var(--lose); }
.acc-label { font-size: 28rpx; flex: 1; }
.acc-sub { font-size: 24rpx; color: var(--ink2); margin-right: 8rpx; }
.acc-arrow { font-size: 30rpx; color: var(--line); }
