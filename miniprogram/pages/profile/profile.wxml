<view class="page">

  <view class="subhead">
    <view class="back" bindtap="goBack">‹</view>
    <view class="sub-title">我的资料</view>
  </view>

  <!-- 当前头像预览 + 昵称 -->
  <view class="card preview-card">
    <view class="preview-avatar">{{avatarEmoji}}</view>
    <view class="preview-name">{{nickname || '我'}}</view>
    <view class="preview-role badge {{role === 'admin' ? 'win' : 'draw'}}">{{role === 'admin' ? '管理员' : '普通用户'}}</view>
  </view>

  <!-- 选择头像 -->
  <view class="card">
    <view class="card-title">选择头像</view>
    <view class="avatar-grid">
      <view
        wx:for="{{avatarList}}"
        wx:key="key"
        class="avatar-item {{avatar === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="pickAvatar"
      >{{item.emoji}}</view>
    </view>
    <view class="avatar-tip">只能从预置头像里选，不支持上传</view>
  </view>

  <!-- 昵称 -->
  <view class="card">
    <view class="card-title">昵称</view>
    <!-- type="nickname" 是微信官方能力：聚焦后点「使用微信昵称」即可一键把真实微信昵称带上来 -->
    <input
      id="nickname-input"
      class="name-input"
      type="nickname"
      value="{{nickname}}"
      placeholder="点这里可一键填入微信昵称"
      placeholder-class="ph"
      maxlength="32"
      bindinput="onNameInput"
      bindnickname="onNickname"
      bindblur="onNicknameBlur"
    />
    <view class="name-tip">点输入框 → 选「使用微信昵称」即可自动填入；也可手动改。最多 32 字</view>
    <button class="btn-primary" bindtap="save" disabled="{{saving}}">保存</button>
  </view>

</view>
