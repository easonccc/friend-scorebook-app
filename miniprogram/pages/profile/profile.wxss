/* pages/profile/profile.wxss */

/* 预览卡 */
.preview-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 28rpx;
}
.preview-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--green-s);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 88rpx;
}
.preview-name {
  font-size: 34rpx;
  font-weight: 700;
}
.preview-role {
  font-size: 22rpx;
}

/* 管理员入口（仅 role===admin 时显示） */
.admin-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.ae-left { display: flex; flex-direction: column; }
.ae-title { font-size: 30rpx; font-weight: 700; }
.ae-sub { font-size: 22rpx; color: var(--ink2); margin-top: 4rpx; }
.ae-arrow { font-size: 44rpx; color: var(--ink2); }

/* 头像网格 */
.avatar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.avatar-item {
  width: calc((100% - 60rpx) / 4);
  height: 120rpx;
  border-radius: 50%;
  background: var(--lose);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}
.avatar-item.on {
  background: var(--green-s);
  border-color: var(--green);
  transform: scale(1.04);
}
.avatar-item:active { transform: scale(0.94); }
.avatar-tip {
  font-size: 22rpx;
  color: var(--ink2);
  margin-top: 18rpx;
  text-align: center;
}

/* 昵称 */
.name-input {
  height: 88rpx;
  background: var(--lose);
  border-radius: 18rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.ph { color: #C4BFAF; }
.name-tip {
  font-size: 22rpx;
  color: var(--ink2);
  text-align: center;
  margin-bottom: 24rpx;
}
.card .btn-primary { margin-top: 8rpx; }
