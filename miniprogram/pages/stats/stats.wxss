/* pages/stats/stats.wxss */

/* 类型筛选 */
.filter-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
  margin-top: 8rpx;
}
.filter-scroll.friend { margin-top: 0; margin-bottom: 14rpx; }
.filter-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 2rpx;
}
.filter-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--card);
  color: var(--ink2);
  font-size: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(58, 55, 47, 0.04);
}
.filter-chip.on {
  background: var(--green);
  color: #FFF;
  font-weight: 600;
}

/* 大数字行 */
.big-row {
  display: flex;
  justify-content: space-between;
}
.big-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.big-num {
  font-size: 48rpx;
  font-weight: 800;
}
.big-num.me { color: var(--green-d); }
.big-num.fr { color: var(--friend); }
.big-num.dr { color: var(--draw-deep); }
.big-num.pos { color: var(--green-d); }
.big-num.neg { color: var(--lose-deep); }
.big-label { font-size: 22rpx; color: var(--ink2); }

/* 金额统计主数字 */
.amount-hero {
  text-align: center;
  padding: 18rpx 0 26rpx;
}
.amount-hero-label {
  font-size: 24rpx;
  color: var(--ink2);
  margin-bottom: 10rpx;
}
.amount-hero-num {
  font-size: 64rpx;
  font-weight: 800;
}
.amount-hero-num.pos { color: var(--green-d); }
.amount-hero-num.neg { color: var(--lose-deep); }
.amount-hero-num.zero { color: var(--ink); }

/* 胜率条 */
.rate-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.rate-name {
  width: 140rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.rate-track {
  flex: 1;
  height: 20rpx;
  background: var(--lose);
  border-radius: 999rpx;
  overflow: hidden;
}
.rate-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.4s ease;
}
.rate-fill.me { background: linear-gradient(90deg, var(--green), #8FD3AC); }
.rate-fill.fr { background: linear-gradient(90deg, var(--friend), #F6BEAA); }
.rate-num {
  width: 110rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
}
.rate-draw {
  font-size: 22rpx;
  color: var(--ink2);
  text-align: right;
  margin-top: 4rpx;
}

/* 最近战绩 */
.recent-text { font-size: 22rpx; color: var(--ink2); font-weight: 400; }
.trend {
  display: flex;
  gap: 14rpx;
  padding: 10rpx 0;
  flex-wrap: wrap;
}
.dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
}
.dot.me { background: var(--green); }
.dot.fr { background: var(--friend); }
.dot.dr { background: var(--draw); }

/* 类型明细 */
.type-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.type-row:last-child { border-bottom: none; }
.type-emoji { font-size: 40rpx; }
.type-main { flex: 1; min-width: 0; }
.type-name { font-size: 26rpx; font-weight: 600; margin-bottom: 10rpx; }
.type-track {
  height: 14rpx;
  background: var(--lose);
  border-radius: 999rpx;
  overflow: hidden;
}
.type-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--green), #8FD3AC);
  border-radius: 999rpx;
}
.type-rate {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--green-d);
  width: 90rpx;
  text-align: right;
}

/* 每次比赛列表 */
.match-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.match-row:last-child { border-bottom: none; }
.match-row:active { opacity: 0.7; }
.match-emoji { font-size: 38rpx; }
.match-main { flex: 1; min-width: 0; }
.match-score {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.score-a {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--green-d);
}
.score-x { font-size: 24rpx; font-weight: 700; color: var(--ink2); }
.score-b {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
}
.match-fr {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink2);
  margin-left: 10rpx;
}
.match-sub {
  font-size: 22rpx;
  color: var(--ink2);
  margin-top: 6rpx;
}
.match-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.match-right-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.match-amt {
  font-size: 22rpx;
  font-weight: 600;
}
.match-amt.pos { color: var(--green-d); }
.match-amt.neg { color: var(--lose-deep); }
.match-amt.zero { color: var(--ink2); }
.badge.me { background: var(--win); color: var(--win-deep); }
.badge.fr { background: var(--lose); color: var(--lose-deep); }
.badge.dr { background: var(--draw); color: var(--draw-deep); }
.match-arrow { font-size: 30rpx; color: var(--line); }
