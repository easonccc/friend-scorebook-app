/* pages/index/index.wxss */

.hero {
  padding: 96rpx 8rpx 24rpx;
}
/* 左上角当前对战下拉筛选（合并名称 + 切换入口） */
.hero-drop {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 60rpx;
  padding: 14rpx 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(58, 55, 47, 0.06);
}
.hero-drop:active { background: var(--green-s); }
.hd-name { font-size: 32rpx; font-weight: 800; }
.hd-vs {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--green-d);
  letter-spacing: 2rpx;
}
.hero-drop .caret {
  font-size: 22rpx;
  color: var(--ink2);
  margin-left: 4rpx;
}

/* 空状态 */
.empty-card {
  text-align: center;
  padding: 60rpx 40rpx;
}
.empty-card .big { font-size: 96rpx; }
.empty-txt { font-size: 32rpx; font-weight: 700; margin-top: 12rpx; }
.empty-sub { font-size: 24rpx; color: var(--ink2); margin: 12rpx 0 40rpx; line-height: 1.7; }

/* 双人 VS 卡 */
.vs-card {
  display: flex;
  align-items: center;
  padding: 40rpx 24rpx;
}
.vs-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--green-s);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.vs-name {
  font-size: 28rpx;
  font-weight: 600;
}
.vs-mid {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.vs-word {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--green-d);
  letter-spacing: 4rpx;
}
.vs-ball { font-size: 44rpx; }

/* 战绩条 */
.lead { font-size: 22rpx; color: var(--ink2); font-weight: 400; }
.rec-bar { padding-top: 8rpx; }
.rec-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
}
.rec-name { color: var(--ink); font-weight: 600; }
.rec-name.right { margin-left: auto; text-align: right; }
.rec-win { color: var(--green-d); font-weight: 700; }
.rec-sep { color: var(--line); }
.rate-track {
  height: 18rpx;
  background: var(--lose);
  border-radius: 999rpx;
  margin-top: 18rpx;
  overflow: hidden;
}
.rate-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--green), #8FD3AC);
  border-radius: 999rpx;
  transition: width 0.4s ease;
}
.rec-total {
  font-size: 22rpx;
  color: var(--ink2);
  margin-top: 12rpx;
  text-align: right;
}

/* 主按钮 */
.big-btn {
  margin-bottom: 32rpx;
  font-size: 34rpx;
  height: 104rpx;
  line-height: 104rpx;
  width: 100%;
}

/* 最近比赛列表 */
.link { font-size: 24rpx; color: var(--green-d); font-weight: 400; }
.rec-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.rec-item:last-child { border-bottom: none; padding-bottom: 6rpx; }
.rec-item:active { opacity: 0.7; }
.rec-emoji {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--green-s);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.rec-main { flex: 1; min-width: 0; }
.rec-score {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
}
.rec-num {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
}
.rec-me { color: var(--green-d); font-weight: 600; }
.rec-fr { color: var(--ink2); font-weight: 600; }
.rec-meta {
  font-size: 22rpx;
  color: var(--ink2);
  margin-top: 4rpx;
}

/* 选择朋友弹层 */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(58, 46, 28, 0.42);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FDFAF4;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  z-index: 91;
  animation: sheetUp 0.28s cubic-bezier(0.2, 0.9, 0.3, 1);
}
@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: none; }
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 24rpx;
}
.space-scroll {
  max-height: 520rpx;
  margin-bottom: 20rpx;
}
.space-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}
.space-item:active { background: var(--green-s); }
.space-item.on {
  border-color: var(--green);
  background: var(--green-s);
}
.space-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--green-s);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.space-main { flex: 1; min-width: 0; }
.space-name {
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.tag-def {
  font-size: 18rpx;
  font-weight: 600;
  background: #FFF3C4;
  color: #9A7B00;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.tag-cur {
  font-size: 18rpx;
  font-weight: 600;
  background: var(--green-s);
  color: var(--green-d);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.space-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.sp-def {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--ink2);
  background: var(--lose);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}
.sp-def:active { transform: scale(0.92); background: var(--green-s); color: var(--green-d); }
.space-sub {
  font-size: 22rpx;
  color: var(--ink2);
  margin-top: 6rpx;
}
.space-check {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--green-d);
}
.space-empty {
  text-align: center;
  color: var(--ink2);
  font-size: 24rpx;
  padding: 40rpx 0;
}
.full-width {
  width: 100% !important;
  margin-bottom: 20rpx;
}
.cancel-btn {
  background: var(--lose);
  color: var(--ink2);
  font-size: 28rpx;
  border-radius: 20rpx;
  line-height: 84rpx;
  height: 84rpx;
}

/* ---------- 首次设置昵称引导弹层 ---------- */
.ob-sheet {
  max-height: 88vh;
  overflow-y: auto;
}
.ob-title {
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}
.ob-sub {
  font-size: 24rpx;
  color: var(--ink2);
  text-align: center;
  margin: 10rpx 0 32rpx;
}
.ob-save {
  margin-top: 28rpx;
  width: 100%;
}
/* 昵称输入框（与个人页一致） */
.name-input {
  height: 88rpx;
  background: var(--lose);
  border-radius: 18rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.ph { color: #C4BFAF; }
.name-tip {
  font-size: 22rpx;
  color: var(--ink2);
  text-align: center;
  margin-bottom: 24rpx;
}
/* 头像网格（与个人页一致） */
.avatar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.avatar-item {
  width: calc((100% - 60rpx) / 4);
  height: 120rpx;
  border-radius: 50%;
  background: var(--lose);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}
.avatar-item.on {
  background: var(--green-s);
  border-color: var(--green);
  transform: scale(1.04);
}
.avatar-item:active { transform: scale(0.94); }
