/* app.wxss - 全局主题
   奶油米白底 + 白卡片 + 柔绿主色，胜=淡黄 / 负=浅灰 / 平=淡蓝
   整个 App 的视觉基调都在这，页面里只写布局 */
page {
  --bg: #FBF6EE;          /* 奶油米白背景 */
  --card: #FFFFFF;        /* 卡片白 */
  --green: #6FBF8F;       /* 主色 柔绿 */
  --green-d: #3E9B6E;     /* 深绿（文字/强调） */
  --green-s: #E7F5EC;     /* 浅绿底 */
  --ink: #3A372F;         /* 主文字 */
  --ink2: #8B8678;        /* 次要文字 */
  --line: #F0EBE0;        /* 分割线 */
  --win: #FFF3D6;         /* 胜利 淡黄 */
  --win-deep: #B98A2F;
  --lose: #F3F1EA;        /* 失败 浅灰 */
  --lose-deep: #9A958A;
  --draw: #E4F0FA;        /* 平局 淡蓝 */
  --draw-deep: #4A7FA6;
  --friend: #F2A68A;      /* 朋友 珊瑚粉 */
  --friend-deep: #C97A5E;
  --friend-s: #FCE9E0;    /* 朋友 淡粉底 */
  --danger: #E0705A;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* ---------- 通用容器 ---------- */
.page {
  min-height: 100vh;
  padding: 0 32rpx 160rpx;   /* 底部留出自定义 TabBar 高度 */
  box-sizing: border-box;
}

/* 顶部标题区（自定义导航栏时用） */
.subhead {
  display: flex;
  align-items: center;
  padding: 96rpx 0 8rpx;
}
.subhead .back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--card);
  border: none;
  color: var(--ink);
  font-size: 44rpx;
  line-height: 72rpx;
  text-align: center;
  margin-right: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(58, 55, 47, 0.06);
}
.subhead .back:active { transform: scale(0.94); }

.sub-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 40rpx;
}
.sub-desc {
  font-size: 24rpx;
  color: var(--ink2);
  margin-top: 4rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(58, 55, 47, 0.05);
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- 按钮 ---------- */
button:not([size="mini"]) {
  width: 100%;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
}
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  width: 100%;
  height: 96rpx;
  padding: 0;
  text-align: center;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(111, 191, 143, 0.35);
}
.btn-primary:active { transform: scale(0.98); }
.btn-primary::after { border: none; }

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  color: var(--ink);
  border-radius: 999rpx;
  font-size: 28rpx;
  height: 80rpx;
  padding: 0;
  text-align: center;
  border: 2rpx solid var(--line);
}
.btn-ghost:active { transform: scale(0.98); }
.btn-ghost::after { border: none; }

.btn-danger {
  background: #FDF1EE;
  color: var(--danger);
  border-radius: 999rpx;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
}
.btn-danger:active { transform: scale(0.98); }
.btn-danger::after { border: none; }

/* ---------- 小徽章 / chips ---------- */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.badge.win { background: var(--win); color: var(--win-deep); }
.badge.lose { background: var(--lose); color: var(--lose-deep); }
.badge.draw { background: var(--draw); color: var(--draw-deep); }

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: var(--ink2);
  font-size: 26rpx;
}
.empty .big { font-size: 72rpx; margin-bottom: 16rpx; }

/* ---------- 通用弹层 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 36, 28, 0.45);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
  animation: slideUp 0.25s ease-out;
}
@keyframes slideUp {
  from { transform: translateY(40%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 28rpx;
}

/* ---------- 类型网格（选择比赛类型，全小程序统一） ---------- */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.type-item {
  width: calc((100% - 60rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 22rpx;
  background: var(--lose);
}
.type-item.on {
  background: var(--green-s);
  box-shadow: inset 0 0 0 3rpx var(--green);
}
.type-emoji { font-size: 48rpx; }
.type-name { font-size: 22rpx; color: var(--ink); }

/* 弹层取消按钮（全小程序统一） */
.sheet-close {
  margin-top: 24rpx;
  background: var(--lose);
  color: var(--ink2);
  font-size: 28rpx;
  border-radius: 20rpx;
  line-height: 84rpx;
  padding: 0;
}
.sheet-close:active { transform: scale(0.98); }
.sheet-close::after { border: none; }

/* ---------- Toast 轻提示 ---------- */
.toast-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.toast-box {
  background: rgba(58, 55, 47, 0.88);
  color: #FFF;
  font-size: 28rpx;
  padding: 24rpx 44rpx;
  border-radius: 999rpx;
  animation: toastPop 0.3s ease-out;
  max-width: 80%;
  text-align: center;
}
@keyframes toastPop {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
