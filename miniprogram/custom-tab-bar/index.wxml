<view class="tab-bar {{hidden ? 'is-hidden' : ''}}">
  <view class="tab-inner">
    <view
      wx:for="{{tabs}}"
      wx:key="text"
      class="tab-item {{item.center ? 'center' : ''}} {{!item.center && selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <view wx:if="{{item.center}}" class="center-btn {{spaceOn ? '' : 'disabled'}}">＋</view>
      <block wx:else>
        <view class="tab-icon">{{item.icon}}</view>
        <view class="tab-text">{{item.text}}</view>
      </block>
    </view>
  </view>
</view>
